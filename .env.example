# ─────────────────────────────────────────────────────────────────────────────
# LOVA_HR — Environment Configuration Template
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Option A: JSON string (preferred for CI/CD / cloud deployments) ──────────
# Paste the entire contents of your serviceAccountKey.json as a single-line
# JSON string. Escape any double-quotes if needed.
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}

# ── Option B: Path to service account JSON file (preferred for local dev) ────
# Place your serviceAccountKey.json at the repo root (it is git-ignored).
# If this env var is NOT set, the app automatically looks for:
#   ./serviceAccountKey.json
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# ── Firebase Project ID (used by gcloud CLI commands) ────────────────────────
# FIREBASE_PROJECT_ID=your-project-id

# ── Firestore Collection Name (default: hr_policies) ─────────────────────────
# FIRESTORE_COLLECTION=hr_policies

# ── BGE Model Overrides (optional — defaults shown) ──────────────────────────
# BGE_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5   # default; BAAI/bge-m3 is swappable (same 1024-dim)
# BGE_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
